import java.io.File;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;

File buildLog = new File(basedir, "build.log");
String log = new String(Files.readAllBytes(buildLog.toPath()), StandardCharsets.UTF_8);
if (!log.contains("Transform: MULTI_TRANSFORM")) {
    throw new Exception("Expected the transform module to be checked.\n" + log);
}
if (!log.contains("No Hop plugin annotations found")) {
    throw new Exception("Expected the core module to be skipped.\n" + log);
}
if (!log.contains("Hop plugin documentation validation passed.")) {
    throw new Exception("Expected DocLint to pass.\n" + log);
}
